# Vault Agent on a CYSTEMD host: AppRole auto-auth, the API proxy the
# control plane calls (no token in CYSTEMD), and a template rendering a
# service's .env file. Generated by internal/vaultagent (go test -update).

vault {
  address = "https://vault.service.consul:8200"
  ca_cert = "/etc/vault-agent/ca.pem"
}

auto_auth {
  method "approle" {
    mount_path = "auth/approle"
    config = {
      remove_secret_id_file_after_reading = false
      role_id_file_path                   = "/etc/vault-agent/role-id"
      secret_id_file_path                 = "/etc/vault-agent/secret-id"
    }
  }
}

api_proxy {
  use_auto_auth_token = true
}

listener "tcp" {
  address     = "127.0.0.1:8100"
  tls_disable = true
}

template_config {
  exit_on_retry_failure         = true
  static_secret_render_interval = "1m"
}

template {
  contents    = "{{- with secret \"kubernetes/data/myproject/myapplication\" }}{{ range $k, $v := .Data.data }}{{ $k }}={{ $v | toJSON }}\n{{ end }}{{ end }}"
  destination = "/opt/myapplication/.env"
  perms       = "0600"
  command     = "systemctl try-restart myapplication.service"
}
